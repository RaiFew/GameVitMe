{
  "name": "party-game-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "start": "node apps/server/dist/index.js",
    "start:dev": "turbo dev",
    "dev:web": "pnpm --filter @party/web dev",
    "dev:server": "pnpm --filter @party/server dev",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @party/server db:generate",
    "db:migrate": "pnpm --filter @party/server db:migrate",
    "db:push": "pnpm --filter @party/server db:push",
    "db:studio": "pnpm --filter @party/server db:studio"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
