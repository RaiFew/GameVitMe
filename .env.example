# =============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================
# Copy this file and fill in the values for your environment:
#
#   Local development:  cp .env.example .env.local
#   Base fallback:      cp .env.example .env
#
# .env.local takes priority over .env and is NEVER committed to git.
# This file (.env.example) SHOULD be committed — it contains no real secrets.
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================
# Local Docker (default):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/partygame
#
# Supabase (Transaction Pooler — use port 6543, NOT 5432):
#   DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/partygame


# =============================================================================
# REDIS
# =============================================================================
# Local Docker:
#   REDIS_URL=redis://localhost:6379
#
# Upstash (production):
#   REDIS_URL=rediss://default:[token]@[endpoint].upstash.io:6380
#
REDIS_URL=redis://localhost:6379


# =============================================================================
# AUTH
# =============================================================================
# Generate a strong secret (at least 32 chars) for production:
#   openssl rand -base64 32
#
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Server base URL (used by Better Auth for OAuth redirects)
# Local:      http://localhost:3001
# Production: https://your-api.vercel.app  (or your custom domain)
BETTER_AUTH_URL=http://localhost:3001


# =============================================================================
# GOOGLE OAUTH (optional in development, required in production)
# =============================================================================
# 1. Go to: https://console.cloud.google.com/
# 2. Create a new project (or use existing)
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 4. Add Authorized Redirect URIs:
#    - http://localhost:3001/api/auth/callback/google   (development)
#    - https://your-api.vercel.app/api/auth/callback/google  (production)
#
# Leave blank in local dev if you don't need Google login yet.
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# =============================================================================
# SERVER
# =============================================================================
PORT=3001
NODE_ENV=development


# =============================================================================
# FRONTEND (Vite — VITE_ prefix is exposed to the browser)
# =============================================================================
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
VITE_APP_URL=http://localhost:3000
