{
  "name": "@party/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^9.0.0",
    "@party/game-engine": "workspace:*",
    "@party/shared-types": "workspace:*",
    "@party/spyfall": "workspace:*",
    "@party/werewolf": "workspace:*",
    "@party/salem": "workspace:*",
    "@party/codenames": "workspace:*",
    "@party/rock-paper-scissors": "workspace:*",
    "@party/number-grid": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.0",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "nanoid": "^5.0.7",
    "postgres": "^3.4.4",
    "socket.io": "^4.7.5",
    "tsx": "^4.7.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "drizzle-kit": "^0.31.0",
    "pg": "^8.23.0",
    "typescript": "^5.4.5"
  }
}
